From 2bb7f3000bd907ffd2ca12513ce9546d6e3726bc Mon Sep 17 00:00:00 2001
From: singhrohit23 <rohitsingh@arista.com>
Date: Wed, 4 Feb 2026 14:54:25 +0530
Subject: [PATCH 3/6] Port 0003: IPsec policy bypass to kernel 6.1.159

---
 net/ipv4/tcp_ipv4.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/net/ipv4/tcp_ipv4.c b/net/ipv4/tcp_ipv4.c
index 7647f1ec0..825013680 100644
--- a/net/ipv4/tcp_ipv4.c
+++ b/net/ipv4/tcp_ipv4.c
@@ -2002,6 +2002,7 @@ int tcp_v4_rcv(struct sk_buff *skb)
 		struct sock *nsk;
 
 		sk = req->rsk_listener;
+		if (!(skb->mark & 0x10000000))
 		if (!xfrm4_policy_check(sk, XFRM_POLICY_IN, skb))
 			drop_reason = SKB_DROP_REASON_XFRM_POLICY;
 		else
@@ -2078,6 +2079,7 @@ int tcp_v4_rcv(struct sk_buff *skb)
 		}
 	}
 
+	if (!(skb->mark & 0x10000000))
 	if (!xfrm4_policy_check(sk, XFRM_POLICY_IN, skb)) {
 		drop_reason = SKB_DROP_REASON_XFRM_POLICY;
 		goto discard_and_relse;
@@ -2126,6 +2128,7 @@ int tcp_v4_rcv(struct sk_buff *skb)
 
 no_tcp_socket:
 	drop_reason = SKB_DROP_REASON_NO_SOCKET;
+	if (!(skb->mark & 0x10000000))
 	if (!xfrm4_policy_check(NULL, XFRM_POLICY_IN, skb))
 		goto discard_it;
 
@@ -2155,8 +2158,10 @@ int tcp_v4_rcv(struct sk_buff *skb)
 	goto discard_it;
 
 do_time_wait:
+        if (!(skb->mark&0x10000000))
 	if (!xfrm4_policy_check(NULL, XFRM_POLICY_IN, skb)) {
 		drop_reason = SKB_DROP_REASON_XFRM_POLICY;
+	if (!(skb->mark & 0x10000000))
 		inet_twsk_put(inet_twsk(sk));
 		goto discard_it;
 	}
-- 
2.34.1

