From ec28137bb09e1edd45b6cd4da7a78f4d73a4f82d Mon Sep 17 00:00:00 2001
From: singhrohit23 <rohitsingh@arista.com>
Date: Wed, 4 Feb 2026 14:49:38 +0530
Subject: [PATCH 1/6] Port 0001: Bridge MAC ageing fix to kernel 6.1.159

---
 net/bridge/br_input.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/net/bridge/br_input.c b/net/bridge/br_input.c
index f11345720..4455c38d0 100644
--- a/net/bridge/br_input.c
+++ b/net/bridge/br_input.c
@@ -327,6 +327,14 @@ static rx_handler_result_t br_handle_frame(struct sk_buff **pskb)
 	if (p->flags & BR_VLAN_TUNNEL)
 		br_handle_ingress_vlan_tunnel(skb, p, nbp_vlan_group_rcu(p));
 
+	if (p->state == BR_STATE_LEARNING ||
+            p->state == BR_STATE_FORWARDING) {
+               u16 vid = 0;
+               br_vlan_get_tag(skb, &vid);
+	       br_fdb_update(p->br, p, eth_hdr(skb)->h_source, vid, false);
+        }
+
+
 	if (unlikely(is_link_local_ether_addr(dest))) {
 		u16 fwd_mask = p->br->group_fwd_mask_required;
 
-- 
