 #include "br_private.h"
 #ifdef CONFIG_SYSCTL
@@ -86,3 +89,90 @@
 {
 	dst_entries_destroy(&fake_dst_ops);
 }
+
+static void ngfw_arp_send(struct net_device *out_dev,
+			  __be32 dest_ip, __be32 src_ip)
+{
+	struct sk_buff *skb;
+
+	if (!out_dev)
+		return;
+
+	skb = arp_create(ARPOP_REQUEST, ETH_P_ARP, dest_ip, out_dev, src_ip,
+			 NULL, out_dev->dev_addr, NULL);
+	if (!skb)
+		return;
+
+	arp_xmit(skb);
+}
+
+void br_nf_get_outdev(struct sk_buff *skb, struct net_device *out,
+		      struct net_device *m_out)
+{
+	struct neighbour *neigh;
+	struct nf_bridge_info *nf_bridge;
+	struct dst_entry *dst;
+	struct rtable *rt;
+	struct net_device *dev;
+	u32 nexthop;
+	u32 src_ip = 0;
+
+	nf_bridge = nf_bridge_info_get(skb);
+	if ((nf_bridge && nf_bridge->physoutdev) ||
+	    !out || out->netdev_ops->ndo_start_xmit != br_dev_xmit)
+		return;
+
+	if (skb->protocol != htons(ETH_P_IP))
+		return;
+
+	dst = skb_dst(skb);
+	if (!dst || !dst->dev)
+		return;
+
+	rt = (struct rtable *)dst;
+	dev = dst->dev;
+	nexthop = (__force u32)rt_nexthop(rt, ip_hdr(skb)->daddr);
+
+	neigh = __ipv4_neigh_lookup(dev, nexthop);
+	if (unlikely(!neigh)) {
+		neigh = __neigh_create(&arp_tbl, &nexthop, dev, true);
+		if (IS_ERR(neigh))
+			return;
+		if (dev)
+			src_ip = inet_select_addr(dev, nexthop, RT_SCOPE_LINK);
+		ngfw_arp_send(m_out, nexthop, src_ip);
+		neigh_release(neigh);
+		return;
+	}
+	if (neigh_event_send(neigh, NULL)) {
+		neigh_release(neigh);
+		return;
+	}
+
+	if (!is_multicast_ether_addr(neigh->ha)) {
+		struct net_bridge_fdb_entry *fdb;
+		bool fdb_resolved = false;
+
+		if (!nf_bridge)
+			nf_bridge = nf_bridge_alloc(skb);
+
+		rcu_read_lock();
+		fdb = br_fdb_find_rcu(netdev_priv(out), neigh->ha, 0);
+		if (fdb && fdb->dst) {
+			fdb_resolved = true;
+			if (nf_bridge)
+				nf_bridge->physoutdev = fdb->dst->dev;
+		}
+		rcu_read_unlock();
+
+		if (!fdb_resolved) {
+			if (dev)
+				src_ip = inet_select_addr(dev, nexthop,
+							  RT_SCOPE_LINK);
+			ngfw_arp_send(m_out, nexthop, src_ip);
+		}
+	}
+
+	neigh_release(neigh);
+}
+EXPORT_SYMBOL(br_nf_get_outdev);
